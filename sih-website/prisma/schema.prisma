// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // You can change to "mysql", "sqlite", or "mongodb"
  url      = env("DATABASE_URL")
}

model Monastery {
  id          String   @id @default(cuid()) // Unique identifier
  slug        String   @unique // URL-friendly slug (e.g., "dubdi-monastery")
  name        String
  location    String
  established String
  overview    String   @db.Text // Use Text for longer content
  imageUrl    String?  // Optional image URL
  
  // JSON fields for complex nested data
  digitalArchive   Json // Stores { description, items: [] }
  audioTour        Json // Stores { description, duration, audioFile }
  culturalCalendar Json // Stores { description, events: [] }
  virtualTour      Json // Stores { description, videoFile, features: [] }
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([slug])
  @@map("monasteries")
}
